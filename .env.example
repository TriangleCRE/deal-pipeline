# Copy to .env for local dev (npm run dev / db:setup / db:seed read this via
# your shell — or use `dotenv`/export manually). In Vercel, set these as
# Project Environment Variables instead.

# Neon connection string (Dashboard -> Connection Details). Works with a
# pooled or direct connection string; sslmode=require is assumed for non-
# localhost hosts.
DATABASE_URL=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Shared passcode for write endpoints (upload/save JSON, View/edit JSON
# save). Anyone with this passcode can add/edit properties. Pick anything
# reasonably long — this is an internal-tool guardrail, not real auth.
PASSCODE=change-me
