# Copy to .env for local dev (npm run dev / db:setup / db:seed read this via
# your shell — or use `dotenv`/export manually). In Vercel, set these as
# Project Environment Variables instead.

# Neon connection string (Dashboard -> Connection Details). Works with a
# pooled or direct connection string; sslmode=require is assumed for non-
# localhost hosts.
DATABASE_URL=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require

# The one shared passcode that gates the entire site (login screen, every
# page, every API route). Also used to sign the session cookie, so changing
# it instantly logs everyone out. Pick something reasonably long — this is
# the layer that actually keeps the site private, not just a write guard.
PASSCODE=change-me
